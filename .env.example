# ──────────────────────────────────────────────────────────────────────────────
# Mahyar Gap — environment variables
# Copy to apps/server/.env for local dev (DATABASE_PUBLIC_URL for local Postgres)
# On Railway these live in the service's Variables tab.
# NEVER commit real values.
# ──────────────────────────────────────────────────────────────────────────────

# Database — on Railway use the INTERNAL url inside the network:
#   postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/railway

# Public DB url only needed for local dev against Railway's DB (optional)
# DATABASE_PUBLIC_URL=

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# LiveKit Cloud (Project Settings → Keys)
LIVEKIT_URL=wss://mydiscord-36exol2s.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Server
NODE_ENV=production          # development locally
PORT=3000                    # provided by Railway automatically

# Registration: invite = needs code (recommended), open = anyone
REGISTRATION_MODE=invite
# Static invite code accepted at registration (in addition to admin-generated invites)
INVITE_CODE=CHANGE-ME-FIRST-INVITE

# Uploads — Railway Volume mount point (create Volume at /data)
UPLOAD_DIR=/data/uploads     # ./data/uploads for local dev

# Radio bot
MAX_CONCURRENT_RADIOS=2
RADIO_MODE=auto              # auto | ingress | rtc

# Logging (pino): fatal error warn info debug
LOG_LEVEL=info
